# Git-accept: ignore everything by default; only whitelisted paths are trackable.
# See scripts/check.sh + REVIEW.md 4.5 for the local check contract.

*
!*/
!.gitignore

# Whitelist the tracked corpus
!/*.md
!/cli/**
!/docs/**
!/scripts/**
!/template/**

# .omo/ is its own nested git repo — never part of the parent tree
/.omo/
